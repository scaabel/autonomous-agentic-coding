{
  "name": "agent-system",
  "version": "0.3.0",
  "description": "Multi-agent AI development system for solo developers",
  "type": "module",
  "bin": {
    "agent": "dist/cli/index.js"
  },
  "scripts": {
    "dev":       "tsx src/cli/index.ts",
    "build":     "tsc",
    "start":     "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "prepublish": "npm run build"
  },
  "files": [
    "dist/",
    "skills/",
    "templates/",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk":             "^5.3.0",
    "commander":         "^12.0.0",
    "dotenv":            "^17.4.2",
    "execa":             "^8.0.1",
    "fs-extra":          "^11.2.0",
    "ora":               "^8.0.1",
    "uuid":              "^9.0.1",
    "zod":               "^3.23.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node":     "^20.0.0",
    "@types/uuid":     "^9.0.8",
    "tsx":             "^4.7.0",
    "typescript":      "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai", "agents", "llm", "cli", "developer-tools",
    "claude", "anthropic", "codegen", "automation"
  ],
  "license": "MIT"
}
