# Anthropic API Key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here

# Model configuration
# Options: claude-sonnet-4-6, claude-haiku-4-5-20251001
# Sonnet = better quality, Haiku = faster + cheaper (recommended for routine tasks)
AGENT_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5-20251001

# Max retries per step before pausing for human input
MAX_RETRIES=2

# Whether to pause for human approval after PRD is generated (recommended: true)
REQUIRE_PRD_APPROVAL=true
